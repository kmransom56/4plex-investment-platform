# 4-Plex Investment Platform - Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://unified_user:unified_pass@localhost:5433/unified_db
NEO4J_URL=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=unified_neo4j_pass
REDIS_URL=redis://:unified_redis_pass@localhost:6380/0

# API Configuration
FORECLOSURE_API_URL=http://localhost:11050
VALUATION_API_URL=http://localhost:3000
INTEGRATION_API_URL=http://localhost:11060

# AI Stack Configuration
VLLM_GATEWAY_URL=http://localhost:9000
AI_STACK_API_KEY=your-ai-stack-key

# External APIs (Optional)
OPENAI_API_KEY=your-openai-key
PROPERTYRADAR_API_KEY=your-propertyradar-key
REALESTATE_API_KEY=your-realestate-api-key
ATTOM_API_KEY=your-attom-data-key

# Monitoring
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION=15d

# Security
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret
NEXTAUTH_SECRET=your-nextauth-secret

# Environment
NODE_ENV=production
PYTHON_ENV=production
LOG_LEVEL=INFO
