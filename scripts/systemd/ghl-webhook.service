[Unit]
Description=GHL Webhook Receiver – real‑time leads from DealDriven / PropWire / GSCCCA
After=network.target

[Service]
Type=simple
User=keith
WorkingDirectory=/home/keith/real_estate/4plex-investment-platform
Environment="PATH=/home/keith/real_estate/4plex-investment-platform/.venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=/home/keith/real_estate/4plex-investment-platform/.env
ExecStart=/home/keith/real_estate/4plex-investment-platform/.venv/bin/uvicorn scripts.webhook_server:app \
    --host 0.0.0.0 \
    --port 9060 \
    --proxy-headers \
    --forwarded-allow-ips="*"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
